# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# --- Aplicación ---
APP_NAME="Agente Inteligente"
ENVIRONMENT=local

# --- Autenticación interna ---
# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_JWT_TTL_MINUTES=15
# JSON {"id_cliente": "<sha256 de la API key>"}. Hash: printf '%s' "$KEY" | shasum -a 256
AUTH_API_KEYS={}

# --- APIs externas (siempre en modo sandbox hasta el despliegue a producción) ---
INTEGRATIONS_SANDBOX=true
META_GRAPH_VERSION=v21.0
META_ACCESS_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
X_BEARER_TOKEN=

# --- Gemini de texto ---
GEMINI_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# El modelo de mayor razonamiento solo se usa desde reasoning y bajo criterios acotados.
GEMINI_FALLBACK_ENABLED=false
GEMINI_FALLBACK_MAX_ATTEMPTS=1
GEMINI_FALLBACK_INPUT_TOKEN_LIMIT=8000
GEMINI_FALLBACK_MAX_OUTPUT_TOKENS=2048

# --- Ingestión de conocimiento ---
GEMINI_API_KEY=
# gemini-embedding-001 reemplaza a text-embedding-004 (retirado por Google)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
DATABASE_URL=postgresql://agente:agente@localhost:5432/agente
